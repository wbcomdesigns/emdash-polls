{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "polls",
	"name": "Polls",
	"keywords": [
		"polls",
		"voting",
		"survey",
		"engagement",
		"feedback"
	],
	"publisher": "did:plc:2o6axbe264shvyedyhycyhya",
	"license": "MIT",
	"repo": "https://github.com/wbcomdesigns/emdash-polls",
	"author": {
		"name": "Wbcom Designs",
		"url": "https://wbcomdesigns.com",
		"email": "security@wbcomdesigns.com"
	},
	"security": {
		"email": "security@wbcomdesigns.com"
	},
	"description": "Create polls, let members vote once, and show live results anywhere on your site.",
	"capabilities": [],
	"allowedHosts": [],
	"storage": {
		"polls": {
			"indexes": [
				"status",
				"createdAt",
				"attach_key"
			]
		},
		"votes": {
			"indexes": [
				"poll",
				"poll_option",
				"member_id"
			]
		}
	},
	"admin": {
		"pages": [
			{
				"path": "/polls",
				"label": "Polls",
				"icon": "sparkle"
			},
			{
				"path": "/edit",
				"label": "Edit",
				"icon": "sparkle"
			}
		]
	}
}
