{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "polls",
	"name": "WB Polls",
	"keywords": [
		"polls",
		"voting",
		"survey",
		"engagement",
		"feedback"
	],
	"publisher": "did:plc:2o6axbe264shvyedyhycyhya",
	"license": "MIT",
	"repo": "https://github.com/wbcomdesigns/emdash-polls",
	"author": {
		"name": "Wbcom Designs",
		"url": "https://wbcomdesigns.com",
		"email": "security@wbcomdesigns.com"
	},
	"security": {
		"email": "security@wbcomdesigns.com"
	},
	"description": "Create polls, let visitors or members vote once, and show live results anywhere on your site.",
	"sections": {
		"description": { "file": "./docs/registry/description.md" },
		"installation": { "file": "./docs/registry/installation.md" },
		"faq": { "file": "./docs/registry/faq.md" },
		"changelog": { "file": "./docs/registry/changelog.md" }
	},
	"capabilities": [],
	"allowedHosts": [],
	"storage": {
		"polls": {
			"indexes": [
				"status",
				"createdAt",
				"attach_key"
			]
		},
		"votes": {
			"indexes": [
				"poll",
				"poll_option",
				"member_id"
			]
		}
	},
	"admin": {
		"pages": [
			{
				"path": "/polls",
				"label": "Polls",
				"icon": "sparkle"
			},
			{
				"path": "/edit",
				"label": "New poll",
				"icon": "plus"
			}
		],
		"widgets": [
			{
				"id": "open",
				"title": "Open polls",
				"size": "half"
			}
		],
		"editorPanels": [
			{
				"id": "poll",
				"title": "Poll",
				"route": "editor_poll"
			}
		]
	},
	"release": {
		"artifacts": {
			"icon": {
				"file": "./icon.png"
			},
			"banner": {
				"file": "./images/banner.png"
			},
			"screenshots": [
				{ "file": "./images/screenshot-1-poll.png" },
				{ "file": "./images/screenshot-2-admin-list.png" },
				{ "file": "./images/screenshot-3-admin-form.png" },
				{ "file": "./images/screenshot-4-admin-results.png" }
			]
		}
	}
}
