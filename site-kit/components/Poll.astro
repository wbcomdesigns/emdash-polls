---
/**
 * One poll on any page. Markup is the same for every visitor.
 *   <Poll id="p_..." />
 *   <Poll latest />
 *   <Poll collection="posts" entry="..." />  (slot lookup)
 */
import "../styles/wbcom-base.css";
import "../styles/polls.css";
import { polls as S } from "../lib/polls-strings";

interface Props {
	id?: string;
	latest?: boolean;
	collection?: string;
	entry?: string;
	/** Slot only: show just polls set to this position. Leave out to show any poll here. */
	position?: "above" | "below" | "";
}

const { id = "", latest = false, collection = "", entry = "", position = "" } = Astro.props;
const uid = `wbp-${collection ? `slot-${collection}-${entry || "none"}${position ? `-${position}` : ""}` : latest ? "latest" : id || "missing"}`;
---

<section class="wb" id={uid} data-wbp data-id={id} data-latest={latest ? "1" : ""} data-collection={collection} data-entry={entry} data-position={position} aria-busy="true">
	<p class="wb-muted" data-wbp-live aria-live="polite">{S.loading}</p>
	<div data-wbp-body></div>
	<p class="wb-status" data-wbp-status role="status" hidden></p>
</section>

<script>
	import { api, esc, signInUrl } from "../lib/wbcom-kit";
	import { phrase, polls as S } from "../lib/polls-strings";

	type Option = { id: string; label: string; count?: number; percent?: number };
	type Poll = {
		id: string;
		question: string;
		options: Option[];
		multiple?: boolean;
		allow_change?: boolean;
		status?: string;
		who?: string;
		named?: boolean;
		results?: string;
		numbers?: string;
		position?: string;
	};
	type Payload = {
		ok?: boolean;
		poll?: Poll;
		choices?: string[];
		results?: { total: number; options: Option[] };
		thanks?: string;
		/** False when this host gives no visitor address: guests sign in to vote. */
		guestWrites?: boolean;
		error?: { code?: string };
	};

	// Every "sign in to do this" refusal, from this engine and the one before it (0.3.0 sends
	// NO_VISITOR where 0.3.1 sends GUEST_UNAVAILABLE), so a kit one version apart never says
	// "Something went wrong" for a known refusal.
	const SIGN_IN_CODES = ["SIGN_IN_REQUIRED", "MEMBERS_ONLY", "GUEST_UNAVAILABLE", "NO_VISITOR"];

	function tell(box: HTMLElement, result: Payload, success = "") {
		box.hidden = false;
		box.dataset.tone = result.ok ? "success" : "error";
		if (result.ok) box.textContent = success;
		else if (SIGN_IN_CODES.includes(result.error?.code ?? "")) {
			// A prompt, not an error: the neutral note style.
			box.dataset.tone = "info";
			box.innerHTML = `${esc(S.signIn)} <a href="${esc(signInUrl())}">${esc(S.signInLink)}</a>`;
		} else box.textContent = phrase(result.error?.code);
	}

	function bars(poll: Poll, results: { total: number; options: Option[] }, mine: string[]) {
		const full = poll.numbers !== "percent";
		return `<ul class="wbp-results">${results.options
			.map((row) => {
				const picked = mine.includes(row.id) ? " is-mine" : "";
				const numbers = full
					? `${esc(S.percent(row.percent ?? 0))} · ${esc(S.count(row.count ?? 0))}`
					: esc(S.percent(row.percent ?? 0));
				return `<li class="wbp-row${picked}"><div class="wbp-row-top"><span>${esc(row.label)}</span><span class="wb-muted">${numbers}</span></div><div class="wbp-bar" role="img" aria-label="${esc(numbers)}"><i style="width:${Math.max(0, Math.min(100, row.percent ?? 0))}%"></i></div></li>`;
			})
			.join("")}</ul><p class="wb-muted">${esc(S.total(results.total))}</p>`;
	}

	function formHtml(uid: string, poll: Poll, mine: string[]) {
		const type = poll.multiple ? "checkbox" : "radio";
		const options = poll.options
			.map((option, index) => {
				const inputId = `${uid}-${option.id}`;
				const checked = mine.includes(option.id) ? " checked" : "";
				return `<label class="wbp-option"><input id="${esc(inputId)}" name="choice" type="${type}" value="${esc(option.id)}"${checked}${index === 0 ? " required" : ""} /><span>${esc(option.label)}</span></label>`;
			})
			.join("");
		const named = poll.named && !mine.length ? `<p class="wb-muted">${esc(S.named)}</p>` : "";
		const label = mine.length ? S.change : S.vote;
		return `<form class="wb-form" data-wbp-form novalidate>${named}<fieldset class="wbp-options"><legend class="wb-sr">${esc(S.answers)}</legend>${options}</fieldset><div class="wb-sr" aria-hidden="true"><label>${esc(S.honeypot)}<input name="website" tabindex="-1" autocomplete="off" /></label></div><div class="wbp-actions"><button class="wb-btn" type="submit">${esc(label)}</button></div></form>`;
	}

	function paint(root: HTMLElement, data: Payload, signedIn: boolean) {
		const body = root.querySelector<HTMLElement>("[data-wbp-body]");
		const live = root.querySelector<HTMLElement>("[data-wbp-live]");
		const status = root.querySelector<HTMLElement>("[data-wbp-status]");
		if (!body || !live) return;
		if (!data.ok || !data.poll) {
			live.textContent = "";
			if (root.dataset.collection) {
				root.hidden = true;
				body.innerHTML = "";
				return;
			}
			body.innerHTML = `<div class="wb-empty"><p><strong>${esc(S.notFound)}</strong></p><p class="wb-muted">${esc(S.notFoundHelp)}</p></div>`;
			return;
		}
		const poll = data.poll;
		const mine = data.choices ?? [];
		const closed = poll.status === "closed";
		// Guests vote only when the engine says this host gives a visitor address. An engine before
		// 0.3.1 sends no guestWrites: treat that as no, so a guest is asked to sign in instead of
		// meeting a refusal after pressing Vote.
		const members = poll.who === "members" || data.guestWrites !== true;
		const canVote = !closed && (!members || signedIn) && (!mine.length || Boolean(poll.allow_change));
		// The route sends results only when this visitor may see them. Before a vote that is still
		// possible, the answers show once, as the form; anyone who cannot vote sees the bars.
		const showBars = Boolean(data.results) && (mine.length > 0 || closed || !canVote);
		let html = `<h2>${esc(poll.question)}</h2>`;
		if (closed) html += `<p class="wb-muted">${esc(S.closed)}</p>`;
		if (showBars) html += bars(poll, data.results as { total: number; options: Option[] }, mine);
		else if (poll.results === "after_vote" && !mine.length) html += `<p class="wb-muted">${esc(S.hidden)}</p>`;
		else if (poll.results === "after_close" && !closed) html += `<p class="wb-muted">${esc(S.hiddenClosed)}</p>`;
		if (mine.length) html += `<p class="wb-muted">${esc(S.voted)}</p>`;
		if (canVote) html += formHtml(root.id || "wbp", poll, mine);
		else if (!closed && members && !signedIn) {
			// Not signed in is a prompt, not an error: the answers (unless the bars already list them),
			// then a neutral sign-in line.
			if (!showBars) html += `<ul class="wbp-results">${poll.options.map((option) => `<li class="wbp-option"><span>${esc(option.label)}</span></li>`).join("")}</ul>`;
			html += `<p class="wbp-note">${esc(S.signIn)} <a href="${esc(signInUrl())}">${esc(S.signInLink)}</a></p>`;
		}
		body.innerHTML = html;
		live.textContent = "";
		if (status) {
			if (data.thanks) tell(status, { ok: true }, data.thanks);
			else {
				status.hidden = true;
				status.textContent = "";
				delete status.dataset.tone;
			}
		}
		bind(root, poll, signedIn);
	}

	function bind(root: HTMLElement, poll: Poll, signedIn: boolean) {
		const form = root.querySelector<HTMLFormElement>("[data-wbp-form]");
		const status = root.querySelector<HTMLElement>("[data-wbp-status]");
		const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");
		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!status || !button) return;
			const picked = [...form.querySelectorAll<HTMLInputElement>("input[name=choice]:checked")].map((input) => input.value);
			if (!picked.length) {
				tell(status, { ok: false, error: { code: "INVALID_CHOICE" } });
				form.querySelector<HTMLInputElement>("input[name=choice]")?.focus();
				return;
			}
			button.setAttribute("aria-busy", "true");
			button.textContent = S.busy;
			root.setAttribute("aria-busy", "true");
			const website = String(new FormData(form).get("website") ?? "");
			const result = signedIn
				? await api("polls", "vote", { id: poll.id, choices: picked })
				: await api("polls", "vote_guest", { id: poll.id, choices: picked, website });
			button.removeAttribute("aria-busy");
			button.textContent = S.vote;
			root.removeAttribute("aria-busy");
			if (result.ok) paint(root, { guestWrites: true, ...(result as Payload) }, signedIn);
			else tell(status, result);
		});
	}

	async function load(root: HTMLElement) {
		const latest = root.dataset.latest === "1";
		const id = root.dataset.id ?? "";
		const collection = root.dataset.collection ?? "";
		const entry = root.dataset.entry ?? "";
		const path = collection
			? `slot?collection=${encodeURIComponent(collection)}&id=${encodeURIComponent(entry)}`
			: latest
				? "get?latest=1"
				: `get?id=${encodeURIComponent(id)}`;
		const got = (await api("polls", path)) as Payload;
		// A slot placed for one position stays empty when the poll is set to the other one.
		const wanted = root.dataset.position;
		// A plugin older than 0.2.3 sends no position: treat it as the default, below, so a poll never shows twice.
		if (collection && wanted && got.poll && (got.poll.position || "below") !== wanted) {
			paint(root, { ok: false }, false);
			root.removeAttribute("aria-busy");
			return;
		}
		if (!got.ok || !got.poll) {
			paint(root, got, false);
			root.removeAttribute("aria-busy");
			return;
		}
		// Pages are cached without regard to cookies, so sign-in is found out here: the member route
		// answers a guest with 401 (expected, and documented in the install guide), then the guest path runs.
		const memberBallot = (await api("polls", `ballot?id=${encodeURIComponent(got.poll.id)}`)) as Payload;
		const signedIn = Boolean(memberBallot.ok);
		let data: Payload = got;
		if (signedIn) data = { ...got, ...memberBallot, poll: memberBallot.poll || got.poll };
		else if (got.poll.who === "anyone" && got.guestWrites === true) {
			const guest = (await api("polls", `ballot_guest?id=${encodeURIComponent(got.poll.id)}`)) as Payload;
			if (guest.ok) data = { ...got, ...guest, poll: guest.poll || got.poll };
		}
		paint(root, data, signedIn);
		root.removeAttribute("aria-busy");
	}

	// The in-text block and the theme's slot can both ask for the same page's poll. The block has
	// no position, so it shows the poll wherever it sits: keep it and drop the other slots for that
	// page, so the poll shows once. A pair of above/below slots alone still splits by position.
	const roots = [...document.querySelectorAll<HTMLElement>("[data-wbp]")];
	const keep = new Map<string, HTMLElement>();
	for (const root of roots) {
		const page = root.dataset.collection ? `${root.dataset.collection}|${root.dataset.entry ?? ""}` : "";
		if (page && !root.dataset.position && !keep.has(page)) keep.set(page, root);
	}
	for (const root of roots) {
		const page = root.dataset.collection ? `${root.dataset.collection}|${root.dataset.entry ?? ""}` : "";
		const winner = page ? keep.get(page) : undefined;
		if (winner && winner !== root) root.remove();
		else void load(root);
	}
</script>
