---
/**
 * Lab only. Mounts the poll so it can be walked in a browser.
 * A real site puts <Poll id /> or <Poll latest /> on its own pages.
 */
import Base from "../layouts/Base.astro";
import Poll from "../components/Poll.astro";

const id = Astro.url.searchParams.get("id") || "";
---

<Base title="Polls demo" description="Lab page for the Polls kit.">
	<div style="max-width: 40rem; margin-inline: auto; padding: 2rem 1rem; display: grid; gap: 3rem;">
		<section>
			<h1>Polls demo</h1>
			<p>This is the component a site owner copies onto any page. Open a poll in admin, then visit this page.</p>
			{id ? <p>Showing one poll from the address bar.</p> : <p>Showing the newest open poll.</p>}
		</section>
		{id ? <Poll id={id} /> : <Poll latest />}
		<section>
			<h2>Missing poll</h2>
			<Poll id="missing" />
		</section>
	</div>
</Base>
